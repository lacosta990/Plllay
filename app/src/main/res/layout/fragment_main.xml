<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#272A30">

    <!-- GeckoView -->
    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:elevation="16dp"
        android:outlineProvider="background"
        android:background="#202020"
        android:clipToOutline="true" />

    <!-- Адресная строка -->
    <LinearLayout
        android:id="@+id/urlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:padding="8dp">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter URL"
            android:autofillHints="url"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:background="@drawable/rounded_edittext"
            android:textColor="@color/url_text_color"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:layout_margin="0dp" />
    </LinearLayout>

    <!-- Нижняя панель навигации -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="0dp">

        <!-- Текстовые кнопки: Назад и Обновить -->
<!--        <LinearLayout-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:orientation="horizontal"-->
<!--            android:layout_marginStart="8dp">-->

<!--            <Button-->
<!--                android:id="@+id/backButton"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="◀"-->
<!--                android:background="#313131"-->
<!--                android:backgroundTint="#313131"-->
<!--                android:textColor="#FFFFFF"-->
<!--                android:padding="12dp" />-->

<!--            <Button-->
<!--                android:id="@+id/reloadButton"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="⟳"-->
<!--                android:background="#313131"-->
<!--                android:backgroundTint="#313131"-->
<!--                android:textColor="#FFFFFF"-->
<!--                android:padding="12dp" />-->
<!--        </LinearLayout>-->

        <!-- Разделитель -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ПРАВАЯ ГРУППА: Вперёд (текст) + Вкладки (иконка) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="8dp">

            <!-- Кнопка Назад -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_back_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                style="?attr/materialButtonStyle"
                android:layout_marginEnd="8dp" />

            <!-- Кнопка + (новая вкладка) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTabButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                style="?attr/materialButtonStyle"
                android:layout_marginEnd="8dp" />

            <!-- Кнопка Tabs с иконкой Material Design -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:icon="@drawable/tab_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                style="?attr/materialButtonStyle" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>