<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#272A30">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:elevation="16dp"
        android:outlineProvider="background"
        android:background="#202020"
        android:clipToOutline="true" />

    <LinearLayout
        android:id="@+id/urlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:padding="8dp">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter URL"
            android:autofillHints="url"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:background="@drawable/rounded_edittext"
            android:textColor="@color/url_text_color"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:layout_margin="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="0dp">

        <!-- ЛЕВАЯ ГРУППА: переключение стороны скраббера -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scrubberSideButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_swap_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                style="?attr/materialButtonStyle" />
        </LinearLayout>

        <!-- Разделитель, растягивается -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ПРАВАЯ ГРУППА -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_back_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                style="?attr/materialButtonStyle"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTabButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                style="?attr/materialButtonStyle"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:icon="@drawable/tab_24px"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#272A30"
                style="?attr/materialButtonStyle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>