<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#202020">

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/tabsRecyclerView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="96dp"/>

    <!-- Кнопка расширений: круглая, иконка, фон экрана, слева -->
    <ImageButton android:id="@+id/extensionsButton" android:layout_width="40dp"
        android:layout_height="40dp" android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp" android:layout_marginBottom="20dp"
        android:background="@drawable/bg_circle" android:src="@drawable/ic_extension_24px"
        app:tint="@color/icon_tint" android:scaleType="centerInside"
        android:contentDescription="Extensions"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newTabButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="24dp" app:srcCompat="@drawable/ic_add_24px"
        app:tint="#FFFFFF" app:backgroundTint="#313131" app:elevation="6dp"
        app:borderWidth="0dp" app:maxImageSize="24dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
