<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp" android:layout_marginBottom="10dp"
    android:paddingStart="14dp" android:paddingEnd="6dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
    android:gravity="center_vertical" android:background="@drawable/tab_card_bg">
    <View android:id="@+id/tabActiveDot" android:layout_width="8dp" android:layout_height="8dp"
        android:layout_marginEnd="10dp" android:background="@drawable/tab_active_dot"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="start">
        <TextView android:id="@+id/tabTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tabAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#8CFFFFFF"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="middle"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <ImageButton android:id="@+id/closeTabButton" android:layout_width="40dp"
        android:layout_height="40dp" android:background="@drawable/bg_circle"
        android:src="@drawable/ic_close_24px" app:tint="@color/icon_tint"
        android:scaleType="centerInside" android:contentDescription="Close tab"/>
</LinearLayout>
