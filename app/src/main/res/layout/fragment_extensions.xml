<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#202020">

    <!-- Строка 48dp: слева иконка расширения, справа крестик -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_extension_24px" app:tint="@color/icon_tint"
            android:contentDescription="Extensions"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/extensionsClose" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_close_24px" app:tint="@color/icon_tint"
            android:scaleType="centerInside" android:contentDescription="Close"/>
    </LinearLayout>

    <!-- Каталог и обновить все: круги 40dp, слева -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/extensionsRefresh" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_refresh_24px" app:tint="@color/icon_tint"
            android:scaleType="centerInside" android:contentDescription="Catalog"/>
        <ImageButton android:id="@+id/extensionsUpdateAll" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_download_24px" app:tint="@color/icon_tint"
            android:scaleType="centerInside" android:layout_marginStart="8dp"
            android:contentDescription="Update all"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/extensionsProgress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone"
        android:layout_gravity="center_horizontal"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/extensionsRecyclerView"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="24dp"/>
</LinearLayout>
