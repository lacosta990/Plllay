<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль для кнопок навигации -->
    <style name="NavButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">#313131</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Стиль для кнопки "New Tab" -->
    <style name="NewTabButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">#313131</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для кнопки закрытия вкладки (крестик) -->
    <style name="CloseTabButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">8dp</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>