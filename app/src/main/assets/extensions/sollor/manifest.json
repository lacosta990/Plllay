{
  "manifest_version": 2,
  "name": "Sollor Player",
  "version": "1.0",
  "description": "Inject custom Plyr player from external source",
  "applications": {
    "gecko": {
      "id": "sollor@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["loader.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "activeTab",
    "<all_urls>",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "storage"
  ]
}